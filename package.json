{
  "name": "tabsiesta",
  "description": "Native tab suspension with shared safety checks for idle tabs and collapsed groups.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "wxt build -b chrome",
    "zip": "wxt zip -b chrome",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/chrome": "^0.1.37",
    "@types/node": "^22.0.0",
    "@wxt-dev/module-svelte": "^2.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0",
    "wxt": "^0.20.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ak5/tabsiesta.git"
  },
  "bugs": {
    "url": "https://github.com/ak5/tabsiesta/issues"
  },
  "homepage": "https://github.com/ak5/tabsiesta#readme"
}
